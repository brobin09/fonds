{
  "name": "fondsos",
  "productName": "FondsOS",
  "version": "1.0.0",
  "description": "Companion for the Fonds Android archive scanner: open export packages, browse, edit and print finding aids.",
  "main": "main.js",
  "author": "Brian Robinson",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "dist": "electron-builder --mac dmg --universal --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.brianrobinson.fonds.mac",
    "productName": "FondsOS",
    "files": [
      "main.js",
      "preload.js",
      "lib.js",
      "renderer/**",
      "package.json",
      "assets/icon.png",
      "adhoc-sign.js"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "icon": "assets/icon.icns",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Fonds package",
            "CFBundleTypeExtension": [
              "zip"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          }
        ]
      },
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "FondsOS",
      "artifactName": "FondsOS.dmg",
      "icon": "assets/icon.icns"
    },
    "afterSign": "adhoc-sign.js"
  }
}